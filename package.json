{
  "name": "woojung-event",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3679",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:init": "node --env-file=.env.local scripts/db-init.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --env-file=.env.local node_modules/vitest/vitest.mjs run src",
    "seed:sample": "SAMPLE_MODE=make node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/ukiki/sample-rooms.seed.test.ts",
    "seed:clean": "SAMPLE_MODE=clean node --env-file=.env.local node_modules/vitest/vitest.mjs run src/lib/ukiki/sample-rooms.seed.test.ts",
    "test:rules": "firebase emulators:exec --only database --project demo-ukiki \"vitest run src/lib/fanfare/rules.emulator.test.ts\"",
    "rules:deploy": "node --env-file=.env.local scripts/deploy-rules.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.5.1",
    "leaflet": "^1.9.4",
    "next": "16.2.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "firebase-tools": "^15.36.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
